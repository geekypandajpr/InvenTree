# InvenTree environment variables for a local development setup
# These variables will be used by the docker-compose.yml file
# You can customize these values for your local environment

INVENTREE_SITE_URL=http://localhost:8000

# Set DEBUG to True for a development setup
INVENTREE_DEBUG=True
INVENTREE_LOG_LEVEL=WARNING
INVENTREE_DB_LOGGING=False

# Database configuration options
# Note: The example setup is for a PostgreSQL database (change as required)
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=inventree-dev-db
INVENTREE_DB_PORT=5432
INVENTREE_DB_USER=pguser
INVENTREE_DB_PASSWORD=pgpassword

# Enable custom plugins?
INVENTREE_PLUGINS_ENABLED=True

# Auto run migrations?
INVENTREE_AUTO_UPDATE=True

# Frontend development server configuration
# The frontend dev server runs on port 5173
# Access it at http://localhost:5173

# CORS (Cross-Origin Resource Sharing) configuration
# Allow all origins (useful for development, set to False for production)
INVENTREE_CORS_ORIGIN_ALLOW_ALL=True
# Allow credentials in CORS requests
INVENTREE_CORS_ALLOW_CREDENTIALS=True
# Comma-separated list of allowed CORS origins (e.g., "http://localhost:5173,http://localhost:3000")
# Leave empty to use defaults or set INVENTREE_CORS_ORIGIN_ALLOW_ALL=True
INVENTREE_CORS_ORIGIN_WHITELIST=http://localhost:5173,http://localhost:8000
# Comma-separated list of CORS origin regex patterns (e.g., "^http://.*localhost:\\d+$")
INVENTREE_CORS_ORIGIN_REGEX=^http://localhost:\\d+$,^http://127\\.0\\.0\\.1:\\d+$

# ALLOWED_HOSTS configuration
# Comma-separated list of allowed hosts (e.g., "localhost,127.0.0.1,example.com")
# In DEBUG mode, defaults to ["*"] if not specified
INVENTREE_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CSRF Trusted Origins
# Comma-separated list of trusted origins for CSRF (e.g., "http://localhost:5173,http://localhost:8000")
INVENTREE_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Admin user configuration
# These credentials will be used to create an admin user on first startup
# The user will be created as a superuser with full access to the system
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_EMAIL=admin@startcomputer.com
INVENTREE_ADMIN_PASSWORD=inventree


# InvenTree environment variables for a domain name setup
# These variables will be used by the docker-compose.yml file
# You can customize these values for your domain environment

# IMPORTANT: Replace inventree.example.com with your actual domain name
# Example: INVENTREE_SITE_URL=https://inventree.example.com
DOMAIN_NAME=inventree.example.com
INVENTREE_SITE_URL=https://inventree.example.com

# Set DEBUG to False for production
INVENTREE_DEBUG=False
INVENTREE_LOG_LEVEL=INFO
INVENTREE_DB_LOGGING=False

# Database configuration options
# Note: The example setup is for a PostgreSQL database (change as required)
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=inventree
INVENTREE_DB_HOST=inventree-domain-db
INVENTREE_DB_PORT=5432
INVENTREE_DB_USER=pguser
INVENTREE_DB_PASSWORD=pgpassword

# Enable custom plugins?
INVENTREE_PLUGINS_ENABLED=True

# Auto run migrations?
INVENTREE_AUTO_UPDATE=True

# CORS (Cross-Origin Resource Sharing) configuration
# For domain setup, allow specific origins
INVENTREE_CORS_ORIGIN_ALLOW_ALL=False
INVENTREE_CORS_ALLOW_CREDENTIALS=True
# Comma-separated list of allowed CORS origins
# Replace inventree.example.com with your actual domain name
INVENTREE_CORS_ORIGIN_WHITELIST=https://inventree.example.com,http://inventree.example.com
# Comma-separated list of CORS origin regex patterns
# Replace inventree.example.com with your actual domain name
INVENTREE_CORS_ORIGIN_REGEX=^https?://.*\\.inventree\\.example\\.com$

# ALLOWED_HOSTS configuration
# Comma-separated list of allowed hosts
# Replace inventree.example.com with your actual domain name
INVENTREE_ALLOWED_HOSTS=inventree.example.com,www.inventree.example.com,localhost,127.0.0.1

# CSRF Trusted Origins
# Comma-separated list of trusted origins for CSRF
# Replace inventree.example.com with your actual domain name
INVENTREE_TRUSTED_ORIGINS=https://inventree.example.com,http://inventree.example.com,https://www.inventree.example.com,http://www.inventree.example.com

# SSL/HTTPS Configuration
# Use X-Forwarded-Proto header (required when behind a reverse proxy like nginx/caddy)
INVENTREE_USE_X_FORWARDED_PROTO=True
INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True

# Cookie settings for HTTPS
INVENTREE_COOKIE_SAMESITE=None
INVENTREE_SESSION_COOKIE_SECURE=True

# Admin user configuration
# These credentials will be used to create an admin user on first startup
INVENTREE_ADMIN_USER=admin
INVENTREE_ADMIN_EMAIL=admin@inventree.example.com
INVENTREE_ADMIN_PASSWORD=inventree

